{
  "dashboard": {
    "title": "PayD API Performance",
    "tags": ["api", "performance"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Request Rate (req/s)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(payd_http_requests_total[5m])",
            "legendFormat": "{{method}} {{path}}"
          }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
      },
      {
        "id": 2,
        "title": "Response Time - p50/p95/p99",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(payd_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(payd_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(payd_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
      },
      {
        "id": 3,
        "title": "Error Rate (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "(rate(payd_http_requests_total{status=~\"5..\"}[5m]) / rate(payd_http_requests_total[5m])) * 100",
            "legendFormat": "5xx errors"
          },
          {
            "expr": "(rate(payd_http_requests_total{status=~\"4..\"}[5m]) / rate(payd_http_requests_total[5m])) * 100",
            "legendFormat": "4xx errors"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
      },
      {
        "id": 4,
        "title": "Top Endpoints by Request Count",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, sum by(path, method) (rate(payd_http_requests_total[5m])))",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
      },
      {
        "id": 5,
        "title": "Slowest Endpoints (p99)",
        "type": "table",
        "targets": [
          {
            "expr": "topk(10, histogram_quantile(0.99, rate(payd_http_request_duration_seconds_bucket[5m])))",
            "format": "table",
            "instant": true
          }
        ],
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
      },
      {
        "id": 6,
        "title": "Response Size (bytes)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(payd_http_response_size_bytes_sum[5m]) / rate(payd_http_response_size_bytes_count[5m])",
            "legendFormat": "{{path}}"
          }
        ],
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
      },
      {
        "id": 7,
        "title": "Active Requests",
        "type": "stat",
        "targets": [
          {
            "expr": "payd_active_requests"
          }
        ],
        "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 }
      },
      {
        "id": 8,
        "title": "Compression Savings",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(rate(payd_response_compression_savings_bytes[5m])) / 1024 / 1024",
            "legendFormat": "MB/s saved"
          }
        ],
        "gridPos": { "x": 6, "y": 24, "w": 6, "h": 4 }
      },
      {
        "id": 9,
        "title": "Compression Ratio",
        "type": "stat",
        "targets": [
          {
            "expr": "avg(payd_response_compression_ratio)"
          }
        ],
        "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 }
      },
      {
        "id": 10,
        "title": "Total Requests (24h)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(increase(payd_http_requests_total[24h]))"
          }
        ],
        "gridPos": { "x": 18, "y": 24, "w": 6, "h": 4 }
      }
    ],
    "templating": {
      "list": [
        {
          "name": "tenant",
          "type": "query",
          "query": "label_values(payd_http_requests_total, tenant_id)",
          "multi": true,
          "includeAll": true
        }
      ]
    },
    "annotations": {
      "list": [
        {
          "name": "Deployments",
          "datasource": "Prometheus",
          "expr": "changes(payd_build_info[5m]) > 0"
        }
      ]
    }
  }
}
