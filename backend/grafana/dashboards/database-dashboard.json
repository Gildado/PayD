{
  "dashboard": {
    "title": "PayD Database Performance",
    "tags": ["database", "postgresql"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Query Duration - p50/p95/p99",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(payd_database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p50 - {{query_type}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(payd_database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 - {{query_type}}"
          },
          {
            "expr": "histogram_quantile(0.99, rate(payd_database_query_duration_seconds_bucket[5m]))",
            "legendFormat": "p99 - {{query_type}}"
          }
        ],
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
      },
      {
        "id": 2,
        "title": "Query Rate by Type",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(payd_database_queries_total[5m])",
            "legendFormat": "{{query_type}}"
          }
        ],
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
      },
      {
        "id": 3,
        "title": "Slow Query Count",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(payd_database_slow_queries_total[5m])",
            "legendFormat": "{{query_type}} - {{table}}"
          }
        ],
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
      },
      {
        "id": 4,
        "title": "Slow Query Rate (%)",
        "type": "graph",
        "targets": [
          {
            "expr": "(rate(payd_database_slow_queries_total[5m]) / rate(payd_database_queries_total[5m])) * 100",
            "legendFormat": "Slow query rate"
          }
        ],
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
      },
      {
        "id": 5,
        "title": "Connection Pool Status",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_pool_total_connections",
            "legendFormat": "Total"
          },
          {
            "expr": "pg_pool_idle_connections",
            "legendFormat": "Idle"
          },
          {
            "expr": "pg_pool_waiting_connections",
            "legendFormat": "Waiting"
          }
        ],
        "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }
      },
      {
        "id": 6,
        "title": "Database Size",
        "type": "graph",
        "targets": [
          {
            "expr": "pg_database_size_bytes / 1024 / 1024 / 1024",
            "legendFormat": "Size (GB)"
          }
        ],
        "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }
      },
      {
        "id": 7,
        "title": "Active Connections",
        "type": "stat",
        "targets": [
          {
            "expr": "pg_active_connections"
          }
        ],
        "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 }
      },
      {
        "id": 8,
        "title": "Slowest Table (p99)",
        "type": "stat",
        "targets": [
          {
            "expr": "topk(1, histogram_quantile(0.99, rate(payd_database_query_duration_seconds_bucket[5m])))"
          }
        ],
        "gridPos": { "x": 6, "y": 24, "w": 6, "h": 4 }
      },
      {
        "id": 9,
        "title": "Backup Verification Status",
        "type": "stat",
        "targets": [
          {
            "expr": "payd_last_backup_verification_timestamp > 0"
          }
        ],
        "gridPos": { "x": 12, "y": 24, "w": 6, "h": 4 }
      },
      {
        "id": 10,
        "title": "Backup Size",
        "type": "stat",
        "targets": [
          {
            "expr": "payd_backup_size_bytes / 1024 / 1024 / 1024",
            "legendFormat": "GB"
          }
        ],
        "gridPos": { "x": 18, "y": 24, "w": 6, "h": 4 }
      }
    ]
  }
}
