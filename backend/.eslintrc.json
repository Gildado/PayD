{
  "parser": "@typescript-eslint/parser",
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "plugins": ["@typescript-eslint"],
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/explicit-module-boundary-types": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "excludedFiles": [
        "src/utils/logger.ts",
        "src/db/migrate.ts",
        "src/examples/**",
        "src/benchmarks/**",
        "src/**/__tests__/**",
        "src/**/*.test.ts"
      ],
      "rules": {
        "no-console": "error"
      }
    }
  ]
}
